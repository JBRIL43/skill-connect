# Skill-Connect Ethiopia — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real credentials.

# --- Supabase (Dev 1 owns; get values from the private secrets channel) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Bypasses RLS — never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM provider (Dev 2 and Dev 3) ---
# Set whichever provider the team settles on; the other can stay blank.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Telebirr sandbox (Dev 1; pending Ethio Telecom developer portal approval) ---
# If credentials do not arrive, the app falls back to a Telebirr-styled mock
# checkout and writes payments.provider = 'mock'.
TELEBIRR_MERCHANT_ID=
TELEBIRR_API_KEY=
TELEBIRR_SANDBOX_URL=

# --- Hackathon-only shortcut: gates the /admin/promote route (Section 4) ---
ADMIN_INVITE_CODE=change-me-before-demo
