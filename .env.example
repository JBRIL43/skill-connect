# Skill-Connect Ethiopia — environment variables
#
#   cp .env.example .env.local
#
# Dev 2 and Dev 3: that copy is enough to run the app. Add your own LLM key and
# you are set — everything else below is Dev 1's and stays blank for you.
#
# This repo is PUBLIC and this is the one env file that is committed, so only
# browser-visible values live here. Server secrets go in .env.local, which is
# gitignored — anything pasted here is scraped by bots within minutes.

# --- Supabase: everyone needs these two -------------------------------------
# Real values, so Dev 2 and Dev 3 can copy this file and start immediately.
# Safe to hold: the anon key is shipped to every browser that loads the app and
# is useless without a login, because Row Level Security decides what each user
# can read. See docs/RLS_MODEL.md.
NEXT_PUBLIC_SUPABASE_URL=https://akowdkidfejsgticaysl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFrb3dka2lkZmVqc2d0aWNheXNsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5OTQ0MzMsImV4cCI6MjEwMDU3MDQzM30.IHZtgldN-_XKQoiTGdZOWeW-dEKY-QzO59l0bFjAhsA

# --- Data source: Dev 3's seam ----------------------------------------------
# 'supabase' uses the live schema and real auth. 'mock' runs the whole app
# against in-memory fixtures with no database, which is the fallback if the
# network or a migration fails on demo day.
#
# Unset counts as mock, so leaving this out gives you a fully seeded app that
# looks live and is serving fixtures. Set it deliberately.
NEXT_PUBLIC_DATA_SOURCE=supabase

# --- Supabase: Dev 1, and Dev 3 server-side ---------------------------------
# Bypasses RLS entirely — full read and write on every table. Dev 1's admin
# console, notification check and payments use it.
#
# Dev 3 also needs it: 0005_column_grants.sql grants an SME update (status) on
# matches and nothing else, so the match engine cannot write match_score or
# gap_analysis as the signed-in user, and ranking reads many candidates' scores,
# which RLS correctly forbids. See docs/dev3-contracts.md.
#
# Dev 2 does not need it. Never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider: Dev 2 and Dev 3 ------------------------------------------
# Use your own key. Set whichever provider the team settles on; leave the other
# blank. Note the choice also fixes the embedding size in the schema, so tell
# Dev 1 before switching.
OPENAI_API_KEY=
GEMINI_API_KEY=

# 'stub' forces deterministic offline grading, assistant replies, and template
# drafting even when a key is present. Leave blank to go live whenever a key is
# set. Grading must never depend on a rate limit clearing mid-demo.
AI_MODE=

# --- Notification check: pending a decision between Dev 1 and Dev 3 ----------
# Set to 1 to route the post-grading check through Dev 1's
# /api/notifications/check instead of lib/matcher/notify.ts.
#
# Off by default because it currently breaks the Pillar 3 beat: their route
# scores a candidate on their latest value per competency, the match engine uses
# their best, so re-grading drops a candidate below a bar they had cleared and
# the notification stops firing while the ranked list still shows them. See
# docs/dev3-contracts.md.
NOTIFY_VIA_DEV1_ROUTE=

# --- Telebirr sandbox: Dev 1 ------------------------------------------------
# Pending Ethio Telecom developer portal approval. If credentials do not arrive,
# the app falls back to a Telebirr-styled mock checkout and writes
# payments.provider = 'mock'.
TELEBIRR_MERCHANT_ID=
TELEBIRR_API_KEY=
TELEBIRR_SANDBOX_URL=

# --- Hackathon-only shortcut: Dev 1 -----------------------------------------
# Gates /admin/promote (Section 4). Anyone holding this can make themselves an
# admin, so it stays off the repo and out of group chats.
ADMIN_INVITE_CODE=change-me-before-demo
