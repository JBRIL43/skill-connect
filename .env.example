# Skill-Connect Ethiopia — environment variables
#
#   cp .env.example .env.local
#
# Dev 2 and Dev 3: that copy is enough to run the app. Add your own LLM key and
# you are set — everything else below is Dev 1's and stays blank for you.
#
# This repo is PUBLIC and this is the one env file that is committed, so only
# browser-visible values live here. Server secrets go in .env.local, which is
# gitignored — anything pasted here is scraped by bots within minutes.

# --- Supabase: everyone needs these two -------------------------------------
# Real values, so Dev 2 and Dev 3 can copy this file and start immediately.
# Safe to hold: the anon key is shipped to every browser that loads the app and
# is useless without a login, because Row Level Security decides what each user
# can read. See docs/RLS_MODEL.md.
NEXT_PUBLIC_SUPABASE_URL=https://akowdkidfejsgticaysl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFrb3dka2lkZmVqc2d0aWNheXNsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5OTQ0MzMsImV4cCI6MjEwMDU3MDQzM30.IHZtgldN-_XKQoiTGdZOWeW-dEKY-QzO59l0bFjAhsA

# --- Supabase: Dev 1 only ---------------------------------------------------
# Bypasses RLS entirely — full read and write on every table. Only the admin
# console, the notification check and payments use it, and all three are Dev 1's.
# Dev 2 and Dev 3 do not need this and should leave it blank: build against
# lib/supabase/server.ts, which runs as the signed-in user.
# Never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider: Dev 2 and Dev 3 ------------------------------------------
# Use your own key. Set whichever provider the team settles on; leave the other
# blank. Note the choice also fixes the embedding size in the schema, so tell
# Dev 1 before switching.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Payments: which rail is live -------------------------------------------
# mock      Telebirr-styled checkout on our own origin. No credentials needed,
#           writes payments.provider = 'mock'. This is the Section 16 fallback
#           and the default, so a fresh clone runs the whole flow immediately.
# telebirr  The real C2B sandbox. Needs every value in the block below.
#
# Switching rails is this line plus a redeploy. Nothing outside lib/payments/
# knows which one is in use.
PAYMENTS_PROVIDER=mock

# --- Telebirr C2B Web Checkout: Dev 1 ---------------------------------------
# From developer.ethiotelecom.et, under C2B WebCheckout Integration. The task
# breakdown named these TELEBIRR_MERCHANT_ID / API_KEY / SANDBOX_URL, which is
# not what Ethio Telecom actually issues; these five are.
#
# All five are server-only and every one of them stays blank in this file. The
# private key in particular signs payment requests as us -- treat it like the
# service role key. Never prefix any of them with NEXT_PUBLIC_, never import
# them into a client component.
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=

# PKCS#8 PEM, on one line with newlines written as \n. Use the portal's
# "SEE PRIVATE KEY" dialog -- the value shown on the dashboard is truncated.
TELEBIRR_PRIVATE_KEY=

# Testbed endpoints. Public, so real values are fine here. Production swaps both
# hosts for superapp.ethiomobilemoney.et.
TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_WEB_CHECKOUT_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?

# Telebirr calls these from their own servers, so they must be publicly
# reachable -- localhost will never be notified. Point them at the deployment
# even while developing locally.
TELEBIRR_NOTIFY_URL=https://skill-connect-orcin.vercel.app/api/payments/telebirr/notify
TELEBIRR_RETURN_URL=https://skill-connect-orcin.vercel.app/dashboard/upgrade/complete

# The testbed on port 38443 serves a certificate Node will not validate, and
# Ethio Telecom's own sample sets rejectUnauthorized: false. Setting this to
# true relaxes verification for Telebirr requests ONLY, via a scoped dispatcher.
# Never set it in production: the blunt fix, NODE_TLS_REJECT_UNAUTHORIZED=0,
# would also cover every Supabase call carrying the service role key.
TELEBIRR_ALLOW_INSECURE_TLS=

# --- Hackathon-only shortcut: Dev 1 -----------------------------------------
# Gates /admin/promote (Section 4). Anyone holding this can make themselves an
# admin, so it stays off the repo and out of group chats.
ADMIN_INVITE_CODE=change-me-before-demo
